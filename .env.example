# Google Apps Script Web App URL from Deploy → New deployment → Web app
# Example: https://script.google.com/macros/s/AKfycb.../exec
VITE_GOOGLE_SHEETS_WEBHOOK_URL=

# Optional shared secret — must match SECRET_TOKEN in flexishift_sheets_backend.gs
VITE_SUBMIT_TOKEN=

# Optional booking URL for 5-minute driver video verification (defaults to /contact)
# Example: https://calendly.com/your-link
VITE_DRIVER_VERIFY_URL=
