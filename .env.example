# Google Apps Script Web App URL from Deploy → New deployment → Web app
# Example: https://script.google.com/macros/s/AKfycb.../exec
VITE_GOOGLE_SHEETS_WEBHOOK_URL=

# Optional shared secret — must match SECRET_TOKEN in flexishift_sheets_backend.gs
VITE_SUBMIT_TOKEN=

# Google Calendar Appointment Scheduling page (video verification)
# Calendar → Appointment schedules → booking page URL. Do not put API keys here.
# Example: https://calendar.google.com/calendar/appointments/schedules/...
VITE_GOOGLE_VERIFICATION_BOOKING_URL=

# Deprecated alias for VITE_GOOGLE_VERIFICATION_BOOKING_URL
VITE_DRIVER_VERIFY_URL=
